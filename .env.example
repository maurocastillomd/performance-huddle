# Performance Huddle — environment template. No secrets in this file.
# Copy to .env and fill in. The demo runs with none of these set.

# ---------------------------------------------------------------- runtime
PORT=4000
# development | test | production. Production turns on several refusals: see docs/SECURITY.md.
NODE_ENV=development
# Set to "disabled" to run the API without serving the built web client.
SERVE_STATIC=enabled

# ---------------------------------------------------------------- identity
# Signs the session cookie. Required when NODE_ENV=production, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo staff switching. Defaults to enabled outside production.
# The server REFUSES TO START if this is enabled while NODE_ENV=production.
DEMO_IDENTITY=enabled

# Microsoft Entra ID single sign-on through the Teams tab.
# Required when NODE_ENV=production, because nothing else can identify a user there.
# UNVERIFIED against a live tenant. See docs/TEAMS-INTEGRATION.md.
TEAMS_SSO=disabled
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_APP_ID_URI=api://huddle.example.com/00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------- model
# mock  = deterministic, no network calls. The default, and what the demo uses.
# azure = server-side Azure OpenAI. Requires all three settings below or the server refuses
#         to start. There is no silent fallback to mock in either direction.
AI_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
